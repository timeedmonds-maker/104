{
  "name": "TREB Corrected OFF Builder",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "mkdir -p team_trb_all_players/impact_database && (nohup bash team_trb_all_players/run_treb_end_to_end_codespace.sh >> team_trb_all_players/impact_database/treb_codespace_autostart.log 2>&1 </dev/null &)",
  "postStartCommand": "mkdir -p team_trb_all_players/impact_database && (nohup bash team_trb_all_players/run_treb_end_to_end_codespace.sh >> team_trb_all_players/impact_database/treb_codespace_autostart.log 2>&1 </dev/null &)",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "CODESPACES_TEAM_TRB.md"
      ]
    },
    "vscode": {
      "settings": {
        "task.allowAutomaticTasks": "off",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "vscode"
}
