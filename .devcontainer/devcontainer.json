{
  "name": "TREB Corrected OFF Builder",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "mkdir -p team_trb_all_players/impact_database && python -m pip install --disable-pip-version-check requests beautifulsoup4 pandas numpy pyarrow duckdb",
  "postStartCommand": "mkdir -p team_trb_all_players/impact_database",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "CODESPACES_TEAM_TRB.md"
      ]
    },
    "vscode": {
      "settings": {
        "task.allowAutomaticTasks": "on",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "vscode"
}
